  "cards": [
    {
      "dot": "emerald",
      "title": "Build layering",
      "items": [
        "lens_util links spdlog only; lens_core links lens_util, bcrypt and crypt32",
        "lens_llm, lens_sync, lens_update, lens_pictures link lens_util and Qt, not lens_core; lens_speech is the first sibling to link lens_core",
        "lens_ocr links lens_capture and owns Qt Network: the scan pipeline itself never reaches it (ADR 0130)",
        "lens_reporter is a pure Win32 companion executable; lens_app is where core, capture and the Qt modules converge"
      ]
    },
    {
      "dot": "rose",
      "title": "Process and privacy",
      "items": [
        "One GUI process: the QML root is a 1×1 transparent, input-transparent window",
        "The API key lives in the reader profile document, never the install directory",
        "Local capture and OCR keep pixels on the machine; online OCR uploads the frozen crop behind the consent gate, speech sends one headword and accent, and only word text rides the LLM batch",
        "A crash writes its dump and spawns the pure-Win32 reporter beside lens.exe"
      ]
    },
    {
      "dot": "amber",
      "title": "Off the happy path",
      "items": [
        "Local OCR runs on one owned worker thread; completion returns by queued signal and stale results are dropped",
        "The mouse hook owns its own thread and re-enters by queued signal",
        "app/glass shares one D3D11 device across surfaces, frame-locked, duplicating the desktop through DXGI"
      ]
    }
  ]
}
