  "cards": [
    {
      "dot": "emerald",
      "title": "Build layering",
      "items": [
        "lens_util links spdlog only; lens_core links lens_util and bcrypt",
        "lens_llm, lens_sync, lens_update, lens_pictures link lens_util and Qt, not lens_core",
        "lens_app is where core, capture and the Qt modules converge"
      ]
    },
    {
      "dot": "rose",
      "title": "Process and privacy",
      "items": [
        "One GUI process: there is no main window, the QML root is never shown",
        "The API key lives in the reader profile document, never the install directory",
        "Capture and OCR stay on the local machine; only word text leaves it"
      ]
    },
    {
      "dot": "amber",
      "title": "Off the happy path",
      "items": [
        "OCR runs on a detached thread polled every 25 ms; stale results are dropped",
        "The mouse hook owns its own thread and re-enters by queued signal",
        "app/glass duplicates the desktop through DXGI for the frosted surfaces"
      ]
    }
  ]
