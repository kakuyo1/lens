  "cards": [
    {
      "dot": "cyan",
      "title": "Two machines",
      "items": [
        "core owns the role machine and is Qt-free; the controller owns the window",
        "QML reads only Pet.action and Pet.scene, never a state enum",
        "Priority: Idle < Situational < Event < Click < Drag; Thinking is replaced by any event"
      ]
    },
    {
      "dot": "emerald",
      "title": "Wander and hide · ADR 0076",
      "items": [
        "120-300 s of true idle before a stroll, a home ellipse of 24-46% of the width",
        "A step ending at the work-area edge rolls 70% into a hide at 34% ink visible",
        "Nothing times a hide out: only a drag out past 0.8 of the width ends it, else it snaps back"
      ]
    },
    {
      "dot": "amber",
      "title": "Scenes and shutdown · ADR 0080",
      "items": [
        "Four scenes per shipped pet: two exclusive, two shared, 12 frames at 4 fps for 30 s",
        "Review answers branch: remembered Celebrate, forgotten Encourage, ignored Angry",
        "Pet.enabled false stops the clock, ends the hide and resets hover; a missing pet falls back to dog"
      ]
    }
  ]
