  "cards": [
    {
      "dot": "emerald",
      "title": "One thread, two escapes",
      "items": [
        "The GUI thread owns every Qt object and the HTTP reply",
        "OCR runs detached and is polled on a 25 ms timer",
        "The mouse hook pumps its own queue and re-enters by queued signal"
      ]
    },
    {
      "dot": "amber",
      "title": "One word per round trip",
      "items": [
        "lens_core classifies the text and returns one lemma, never the whole screen",
        "The queue caps a batch at five words, the client at twenty",
        "There is no retry: a failed batch shows a notice and re-runs the queue"
      ]
    },
    {
      "dot": "rose",
      "title": "Tolerant parse, strict echo",
      "items": [
        "Advisory fields are read but never demanded, and a mistyped one reads false",
        "A repeated word echo is folded into the held entry, not a failure",
        "A word nobody asked for rejects the whole batch"
      ]
    }
  ]
