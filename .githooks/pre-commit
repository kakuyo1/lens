#!/bin/sh
# Lens pre-commit: the checks that are mechanical and cheap.
#
# 1. Chinese typography, as a ratchet: every staged .md is held to zero zhlint errors. The skips
#    inside check_typography each carry their reason -- agent-facing documents (AGENTS.md's Lint
#    section draws that line), non-Chinese documents, and frozen text. The old per-doc BASELINES
#    list converged to all zeros and had drifted away from the tree, so it is gone; the ratchet's
#    only direction survives: fix the line rather than add an exemption.
# 2. C++ formatting. The tree was formatted once by hand and then left to drift; this is what
#    stops that. clang-format is not on PATH on this machine, so the copy Visual Studio ships is
#    looked for as a fallback.
# 3. Probe scaffolding. TEST.md section 5 says anything added to src/ to see what is going on --
#    a timer, a console.log -- has to be gone before the commit lands. Those are deterministic
#    strings, so a grep settles it; leaving it to memory is what this check replaces.
# 4. QML. The odd one out: a .qml file only lints correctly beside its whole module, so this
#    runs the full set instead of the staged subset, and it wants a configured build tree.
#    scripts/quality/qml-lint.sh owns the arguments, the count and the reasoning.
# 5. Absolute paths in our own sources. A machine path written into a file is a value that is
#    wrong on the next machine, and this project had the same Qt prefix handwritten in four
#    places. config/paths.default.json is the one file allowed to hold them; config/README.md owns the
#    rule and names every exemption, docs/adr/0006 the reasoning. That rule is about what ships,
#    so test/ is out of scope: several fixtures exist to refuse a machine path, and naming one is
#    the assertion. See the exemption's own note in config/README.md.
# 6. Font weights. DESIGN.md section 3.2 allows two weights, 400 and 700. A named or numeric weight
#    outside those in a .qml file is caught here.
# 7. Phase labels. DESIGN.md, UI-SPEC.md and ui-prototypes/ do not name a development phase.
# 8. Chinese in code. DESIGN.md's i18n section keeps code English; the one Chinese fixture is in test/.
# 9. File headers. Every src/ C++ file opens with a /** @file block (AGENTS.md, Code Style).
# 10. QML size. QML.md section 1 caps a .qml file at 32768 characters.
# 11. API keys. A key-shaped string in a staged file is refused, and only its line number is
#     printed, so the hook does not echo the key into the log.
# 12. Translations. A staged .ts file that still carries an unfinished string has one nobody
#     translated: lupdate leaves it there, and the goal is zero.
# 13. Layers. The module boundaries CODING_STANDARDS.md and ADR 0077 name: core stays Qt-free,
#     and duties, platform, glass and pet do not reach into one another or the facade. It reads
#     the whole tree when a src/ file is staged, because an include left behind sits in a file
#     the commit may not touch. scripts/quality/layer-check.sh owns the rules.
#
# Only what this commit touches is checked, which keeps a commit hook under a few seconds. The
# QML check is the exception, and it is the one that only runs when a .qml file is staged.
#
# CI runs this same file over the files a push or pull request changes: LENS_CHECK_FILES carries
# that list, and LENS_SKIP_QML=1 leaves QML to the qml jobs, which have their build trees.
# LENS_SKIP_TYPOGRAPHY=1 leaves the typography to .github/workflows/docs.yml, which runs for
# every change that touches a document. See .github/workflows/ci.yml, job hygiene.
#
# Setup, once per clone:  git config core.hooksPath .githooks
#
# The hook also has to be executable, which git records in the tree rather than reading from
# the disk: if git ever reports it as skipped, run
#     git update-index --chmod=+x .githooks/pre-commit
#
# Every check warns and passes when its tool is unavailable, so a missing zhlint or clang-format,
# or an odd environment, cannot make the repository uncommittable.
#
# Two things about zhlint that cost an afternoon to learn: it exits 1 when it finds errors
# (so the exit code cannot tell "found problems" from "did not run" -- an empty report is
# the signal), and it takes exactly one file argument (passing more silently checks only the
# first, which is the same as checking nothing).

set -u

# The Chinese patterns and grep -P need a UTF-8 locale. Under zh_CN, grep -P exits 2 and the
# check reads that as a pass.
export LC_ALL=C.UTF-8

cd "$(git rev-parse --show-toplevel)" || exit 0

# The files the checks read: what a commit stages, or the list CI hands in through LENS_CHECK_FILES.
staged=${LENS_CHECK_FILES:-$(git diff --cached --name-only --diff-filter=ACM)}

# One value out of config/paths.default.json, through the reader the PowerShell scripts and CMake use, so
# the merge with config/paths.local.json happens the same way everywhere. Through PowerShell
# because it is the only JSON parser this machine is certain to have: jq is not on PATH, and a
# grep for a JSON value is a check that breaks the first time a value contains a comma.
#
# Prints nothing when the key, the file or PowerShell is missing; each caller then skips its own
# check with a message, the contract the rest of this hook keeps.
lens_path() {
    command -v powershell >/dev/null 2>&1 || return 0
    [ -f config/paths.default.json ] || return 0
    powershell -NoProfile -ExecutionPolicy Bypass -Command \
        ". ./scripts/build/paths.ps1; \$p = Get-LensPaths -Root \$PWD; \$p.$1" 2>/dev/null | tr -d '\r'
}

# The same for a list-valued key: one item per line.
lens_path_list() {
    command -v powershell >/dev/null 2>&1 || return 0
    [ -f config/paths.default.json ] || return 0
    powershell -NoProfile -ExecutionPolicy Bypass -Command \
        ". ./scripts/build/paths.ps1; Get-LensPathList -Root \$PWD -Key $1" 2>/dev/null | tr -d '\r'
}

check_typography() {
    # The document check runs in .github/workflows/docs.yml, which installs the pinned zhlint and
    # sees every change that touches a .md file. The hygiene job sets this so a mixed change does
    # not check the same text twice.
    if [ -n "${LENS_SKIP_TYPOGRAPHY:-}" ]; then
        return 0
    fi

    # zhlint from PATH when it is installed (npm i -g zhlint), because the npx fallback
    # resolves the package name against the registry on every call: one network round trip
    # per staged doc, which came to minutes of the hook's run time when the proxy was down.
    # The fallback stays for a machine that has not installed it, and for CI.
    if command -v zhlint >/dev/null 2>&1; then
        run_zhlint() { zhlint "$@"; }
    elif command -v npx >/dev/null 2>&1; then
        run_zhlint() { npx -y zhlint "$@"; }
    else
        echo "pre-commit: neither zhlint nor npx found, skipping typography"
        return 0
    fi

    config=$(lens_path zhlintConfig)
    # The machine value names a skill asset, which a runner does not have. The repository copy
    # carries the same rules, so CI checks typography with it instead of skipping the check.
    [ -n "$config" ] && [ -f "$config" ] || config="scripts/quality/zhlintrc.json"
    if [ ! -f "$config" ]; then
        echo "pre-commit: $config not found, skipping typography"
        return 0
    fi

    status=0
    for doc in $staged; do
        case "$doc" in
            *.md) ;;
            *) continue ;;
        esac
        # Skips, each with its reason. Agent-facing documents are outside zhlint by AGENTS.md's own
        # Lint section -- it is for documents people read -- which covers .claude/skills/ too.
        # zhlint's rules are Chinese typography: they flag English punctuation and every
        # Japanese-Latin boundary, so the English documents (the English, Spanish and Japanese
        # READMEs, SECURITY.md, data/wordlist-source.md) are left out; README.md (Chinese) and
        # README.zh-TW.md stay in.
        # docs/history/ is archived text that predates the ratchet and stays frozen;
        # third_party/ is vendored.
        case "$doc" in
            AGENTS.md | CLAUDE.md | CLAUDE.local.md | .claude/skills/* | docs/agents/*) continue ;;
            README.en.md | README.es.md | README.ja.md | SECURITY.md | data/wordlist-source.md) continue ;;
            docs/history/* | third_party/*) continue ;;
        esac

        # Both streams: zhlint prints the offending lines on stderr and the verdict on
        # stdout. Keeping only stdout counts zero every time, which is a check that always
        # passes -- the failure mode this hook exists to avoid.
        #
        # The backslash swap is not cosmetic. zhlint prints the path as it found it, which on
        # Windows means "docs\adr\README.md", while the staged name git hands us is
        # "docs/adr/README.md". The count greps anchor on the name, so without this every doc
        # below the root counts zero and silently passes.
        report=$(run_zhlint --config "$config" "$doc" 2>&1 | tr '\\' '/')
        # "Found 1 error." is singular -- matching only "errors\." would let a doc with exactly
        # one error report no verdict.
        if ! printf '%s\n' "$report" | grep -qE '[0-9]+ errors?\.|No error found'; then
            echo "pre-commit: zhlint gave no verdict for $doc, skipping typography"
            continue
        fi

        count=$(printf '%s\n' "$report" | grep -cE "^$doc:[0-9]+:")
        if [ "$count" -gt 0 ]; then
            # Line numbers, not messages: the first few messages usually sit on lines the reader
            # did not touch, which sends them to fix something they did not break.
            lines=$(printf '%s\n' "$report" | grep -oE "^$doc:[0-9]+" | cut -d: -f2 | sort -nu | head -10 | tr '\n' ' ')
            echo "pre-commit: $doc has $count typography errors"
            echo "  affected lines: $lines"
            echo "  messages: zhlint --config \"$config\" $doc"
            echo "  (the budget is zero; fix the line rather than add an exemption)"
            status=1
        fi
    done
    return $status
}

# clang-format is not on PATH on this machine; the copy Visual Studio ships is the fallback. That
# list is a machine path like any other and comes from config/paths.default.json. Read inside the function
# rather than at the top of the file: the check skips itself when there is no formatter, and
# paying for a PowerShell start on every commit that touches no C++ would be the tail wagging the
# dog.

check_formatting() {
    printf '%s\n' "$staged" | grep -qE '\.(cpp|h|hpp|cc)$' || return 0

    formatter=$(command -v clang-format 2>/dev/null || true)
    if [ -z "$formatter" ]; then
        while read -r candidate; do
            if [ -x "$candidate" ]; then
                formatter="$candidate"
                break
            fi
        done <<EOF
$(lens_path_list clangFormatFallbacks)
EOF
    fi
    if [ -z "$formatter" ]; then
        echo "pre-commit: clang-format not found, skipping the format check"
        return 0
    fi

    files=
    for file in $staged; do
        case "$file" in
            third_party/*) continue ;;
            *.cpp | *.h | *.hpp | *.cc) ;;
            *) continue ;;
        esac
        [ -f "$file" ] || continue
        files="$files $file"
    done
    [ -n "$files" ] || return 0

    # One invocation for the whole commit on the clean path: --dry-run --Werror exits non-zero when
    # any file differs from .clang-format, which is the whole test. The per-file form below runs
    # only when something is actually wrong, where it can afford to print the diff.
    if "$formatter" --dry-run --Werror $files >/dev/null 2>&1; then
        return 0
    fi

    status=0
    for file in $files; do
        # The config is found by searching upward from the file, so nothing here has to name it.
        if ! "$formatter" --dry-run --Werror "$file" >/dev/null 2>&1; then
            echo "pre-commit: $file is not clang-formatted"
            "$formatter" "$file" 2>/dev/null | diff "$file" - | head -8
            echo "  fix with: \"$formatter\" -i $file"
            status=1
        fi
    done
    return $status
}

# The two markers TEST.md section 5 names. Matched as written, so a comment about them -- like
# the one in TEST.md, or this one -- has to live outside src/ to stay out of the way.
PROBE_PATTERN='PROBE|console\.log'

# The checks below all ask the same question of a different set of files: does this pattern appear
# anywhere in them. Asked one file at a time that was a process per file per check -- about 400
# spawns for a 40-file commit, and on Windows a spawn costs 200-300 ms, which measured 2m20 for a
# commit whose own work was 27 s of user time. So: filter with the shell's own case (free), then
# grep the whole list once and group the answer back per file.

# @return The staged files matching @pattern, one per line. A case pattern, so alternation works.
staged_matching() {
    for file in $staged; do
        case "$file" in
            $1) [ -f "$file" ] && printf '%s\n' "$file" ;;
        esac
    done
}

# @brief Print grep -n -H output as one block per file: @prefix, the file, @suffix, up to ten hits,
#        then @advice. Reads stdin.
report_hits() {
    awk -F: -v prefix="$1" -v suffix="$2" -v advice="$3" '
        $1 != last {
            if (last != "") print advice
            printf "%s%s%s\n", prefix, $1, suffix
            last = $1
            shown = 0
        }
        shown < 10 { print; shown++ }
        END { if (last != "") print advice }'
}

# @brief Search @files for @pattern and report every file it appears in.
# @return 1 when something was found, so a caller can `scan ... || status=1`.
scan() {
    pattern=$1
    prefix=$2
    suffix=$3
    advice=$4
    shift 4
    [ "$#" -gt 0 ] || return 0

    hits=$(grep -nHE -- "$pattern" "$@" 2>/dev/null || true)
    [ -n "$hits" ] || return 0

    printf '%s\n' "$hits" | report_hits "$prefix" "$suffix" "$advice"
    return 1
}

# The developer surface (docs/adr/0068) is not probe scaffolding. It is a standing interface, compiled only under
# LENS_ENABLE_DEV_SURFACE, and its sources contain neither marker. Nothing in it is removed before a commit, so this
# check does not treat it as something to remove.
check_probes() {
    printf '%s\n' "$staged" | grep -q '^src/' || return 0

    status=0
    files=$(staged_matching 'src/*')
    [ -n "$files" ] || return 0

    scan "$PROBE_PATTERN" "pre-commit: " " still carries probe scaffolding" \
        "  delete it before committing -- TEST.md section 5 says why" $files || return 1
    return 0
}

check_qml() {
    if [ -n "${LENS_SKIP_QML:-}" ]; then
        return 0
    fi
    printf '%s\n' "$staged" | grep -q '^src/app/qml/' || return 0
    [ -x scripts/quality/qml-lint.sh ] || { echo "pre-commit: scripts/quality/qml-lint.sh not found, skipping QML lint"; return 0; }
    scripts/quality/qml-lint.sh
}

# A machine path written into a source file is a value that is wrong on the next machine. The one
# file that may hold one is config/paths.default.json, which exists for that; config/README.md names every
# exemption below and why it is exempt. Scoped to the files a commit touches, like the rest here.
check_absolute_paths() {
    files=
    for file in $staged; do
        case "$file" in
            # Vendored and generated trees, and the file that exists to hold these values.
            third_party/* | package-lock.json | config/paths.default.json) continue ;;
            # Documents quote paths as prose, and every icon carries an xmlns URL.
            *.md | *.svg) continue ;;
            # Tests are not what ships, and refusing a machine path is what some of them assert: a
            # fixture spells out a drive-letter path and expects the reader to refuse it. Exempt
            # rather than let the check argue with a fixture -- 2026-10-15 it did, the fixture was
            # rewritten to dodge it, and the commit landed --no-verify.
            test/*) continue ;;
        esac
        [ -f "$file" ] || continue
        files="$files $file"
    done
    [ -n "$files" ] || return 0

    # A URL is not a filesystem path and neither is a Qt resource URI. The line is filtered
    # rather than the file, so a real path sharing a line with a link is still reported.
    #
    # The drive letter has to start a token -- nothing alphanumeric or _ before it -- or
    # cmd's own substitution syntax reports itself: build.bat's QTBACK line puts a letter, a
    # colon and a slash in that order inside %QT_ROOT:/=\%, with the letter mid-word. The
    # sequence is spelled out rather than quoted here because the quoting is what matched.
    # -I skips binary files: compressed image bytes can hold a drive-letter sequence by
    # chance, and grep reports such a file as a bare "Binary file ... matches" line.
    hits=$(grep -nHIE '(^|[^A-Za-z0-9_])[A-Za-z]:[\\/]' $files 2>/dev/null | grep -vE 'https?://|qrc:/' || true)
    [ -n "$hits" ] || return 0

    printf '%s\n' "$hits" | report_hits "pre-commit: " " carries an absolute path" \
        "  machine paths belong in config/paths.default.json; config/README.md says how to read it,
  and what the check deliberately does not cover."
    return 1
}

# DESIGN.md section 3.2: two font weights, Normal (400) and Bold (700). Font.DemiBold, Font.SemiBold
# and the other named weights, or a numeric font.weight, all break that.
check_font_weights() {
    files=$(staged_matching '*.qml')
    [ -n "$files" ] || return 0

    scan 'Font\.(Thin|ExtraLight|Light|Medium|SemiBold|DemiBold|ExtraBold|Black)\b|font\.weight\s*:\s*[0-9]' \
        "pre-commit: " " uses a font weight other than 400 or 700" \
        "  DESIGN.md section 3.2 allows Normal and Bold only" $files || return 1
    return 0
}

# DESIGN.md, UI-SPEC.md and the prototypes describe the product, and a product surface names no development phase.
check_phase_labels() {
    files=$(staged_matching 'DESIGN.md|UI-SPEC.md|ui-prototypes/*')
    [ -n "$files" ] || return 0

    scan '阶段[一二三四五六七八九十0-9]|PHASE-?[0-9]' \
        "pre-commit: " " names a development phase" \
        "  describe what the surface does instead of which phase it belongs to" $files || return 1
    return 0
}

# DESIGN.md's i18n section: code is English, and every string goes through tr(). The one Chinese
# fixture lives under test/, outside src/, so src/ has no exception.
check_cjk() {
    files=$(staged_matching 'src/*.cpp|src/*.h|src/*.hpp|src/*.cc|src/*.qml')
    [ -n "$files" ] || return 0

    hits=$(grep -nHP '[\x{4E00}-\x{9FFF}]' $files 2>/dev/null || true)
    [ -n "$hits" ] || return 0

    printf '%s\n' "$hits" | report_hits "pre-commit: " " has Chinese in code" \
        "  write the English source string and let lupdate carry the Chinese (DESIGN.md, i18n)"
    return 1
}

# AGENTS.md, Code Style: every src/ C++ file opens with a /** @file block.
check_file_headers() {
    files=$(staged_matching 'src/*.cpp|src/*.h|src/*.hpp|src/*.cc')
    [ -n "$files" ] || return 0

    # One pass for the whole list: awk remembers which files carried the block, and names the rest.
    missing=$(awk 'FNR <= 20 && /@file/ { seen[FILENAME] = 1 }
                   END { for (i = 1; i < ARGC; ++i) if (!(ARGV[i] in seen)) print ARGV[i] }' $files)
    [ -n "$missing" ] || return 0

    printf '%s\n' "$missing" | while read -r file; do
        echo "pre-commit: $file has no /** @file block in its first 20 lines"
        echo "  AGENTS.md, Code Style: every file opens with one"
    done
    return 1
}

# QML.md section 1: a .qml file over 32768 characters does not parse.
check_qml_size() {
    files=$(staged_matching '*.qml')
    [ -n "$files" ] || return 0

    # One wc for the whole list; the count is the first field and the name the second. The last
    # line wc prints for more than one file is the total, which is not a file.
    sizes=$(LC_ALL=C.UTF-8 wc -m $files 2>/dev/null || true)
    [ -n "$sizes" ] || return 0

    printf '%s\n' "$sizes" | awk '$2 == "total" { next }
        $1 > 32768 {
            printf "pre-commit: %s is %s characters; QML.md section 1 caps a .qml file at 32768\n", $2, $1
            bad = 1
        } END { exit bad ? 1 : 0 }' || return 1
    return 0
}

# AGENTS.md: the key lives in the profile's settings.json and nowhere else. Only line numbers are
# printed: echoing the match would print the key into the terminal and the transcript.
check_api_keys() {
    files=$(staged_matching '*')
    [ -n "$files" ] || return 0

    hits=$(grep -nHIE 'sk-[A-Za-z0-9_-]{20,}' $files 2>/dev/null || true)
    [ -n "$hits" ] || return 0

    # One line per file, listing only the line numbers: the match itself never reaches the terminal.
    printf '%s\n' "$hits" | awk -F: '
        $1 != last {
            if (last != "") print "  keys stay in the profile'"'"'s settings.json; remove the value before committing"
            printf "pre-commit: %s looks like it holds an API key, at line(s) ", $1
            last = $1
            sep = ""
        }
        { printf "%s%s", sep, $2; sep = " " }
        END {
            if (last != "") print "\n  keys stay in the profile'"'"'s settings.json; remove the value before committing"
        }'
    return 1
}

# AGENTS.md, Translations: lupdate appends a new string as unfinished, and the goal is zero. A staged
# .ts file that still carries one has a string nobody has translated.
check_unfinished() {
    files=$(staged_matching 'i18n/*.ts')
    [ -n "$files" ] || return 0

    scan 'type="unfinished"' "pre-commit: " " has unfinished translations" \
        "  translate each one and rerun lrelease (AGENTS.md, Translations)" $files || return 1
    return 0
}

check_layers() {
    printf '%s\n' $staged | grep -qE '^src/' || return 0
    [ -f scripts/quality/layer-check.sh ] || { echo "pre-commit: scripts/quality/layer-check.sh not found, skipping layers"; return 0; }
    sh scripts/quality/layer-check.sh
}

# "fail", not "status": every check below keeps its own running answer in a shell-wide
# "status", so a dispatcher that used the same name would have an earlier failure wiped out by
# the next check finishing cleanly. That is not hypothetical -- with "status" here, a document
# over its typography budget was reported and then forgotten by a clean formatting run, and the
# commit went through.
fail=0
check_typography || fail=1
check_formatting || fail=1
check_probes || fail=1
check_qml || fail=1
check_absolute_paths || fail=1
check_font_weights || fail=1
check_phase_labels || fail=1
check_cjk || fail=1
check_file_headers || fail=1
check_qml_size || fail=1
check_api_keys || fail=1
check_unfinished || fail=1
check_layers || fail=1
exit $fail
